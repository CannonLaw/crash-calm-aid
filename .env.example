VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# PostHog analytics (Priority 3). Leave blank to no-op analytics in dev.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Edge Function secrets (set in the Supabase project, NOT here):
#   RESEND_API_KEY              - required by send-report-email
#   RESEND_FROM_EMAIL           - optional, defaults to reports@cannonlaw.com
#   ZAPIER_LEADS_WEBHOOK_URL    - required by submit-lead for PP forwarding
#   APP_ORIGIN                  - required for CORS on submit-lead and
#                                 send-report-email (e.g. https://app.cannonlaw.com)
